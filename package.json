{
  "name": "modelart-tracker",
  "version": "0.4.0",
  "description": "Project tracker for Modelart model builds",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --win",
    "release": "node scripts/release.mjs"
  },
  "author": "Modelart",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@phosphor-icons/react": "^2.1.10",
    "canvas-confetti": "^1.9.3",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  },
  "productName": "Modelart Tracker",
  "repository": {
    "type": "git",
    "url": "https://github.com/diets89/Modelart-Project-Tracker.git"
  },
  "build": {
    "appId": "za.co.modelart.tracker",
    "productName": "Modelart Tracker",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Modelart-Tracker-Setup-${version}.${ext}",
      "shortcutName": "Modelart Tracker"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "diets89",
        "repo": "Modelart-Project-Tracker",
        "releaseType": "release"
      }
    ]
  }
}
